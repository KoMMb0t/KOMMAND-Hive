{
  "name": "kommand-hive",
  "version": "0.1.0",
  "description": "Command your AI swarm — Multi-agent orchestration platform",
  "main": "src/main/index.js",
  "author": "KoMMb0t",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.kommb0t.kommand-hive",
    "productName": "KOMMAND Hive",
    "directories": { "output": "dist" },
    "win":   { "target": "nsis" },
    "mac":   { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
